<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Cleaner" Width="1320" Height="860" MinWidth="1040" MinHeight="660"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource Text1}"
        Background="{DynamicResource Base}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True">
  <Window.Resources>
    <GridLength x:Key="ColReason">210</GridLength>
    <GridLength x:Key="ColSize">130</GridLength>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Drawn only when moving with the keyboard, like the Windows 11 focus ring. -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
        <Border BorderBrush="{DynamicResource Text1}" BorderThickness="2" CornerRadius="6" Margin="-1" SnapsToDevicePixels="True"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Subtitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Strong" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Text2}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text2}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20,16"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/><Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlPressed}"/><Setter Property="Foreground" Value="{DynamicResource Text2}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Text1}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bd" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentStroke}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Text1}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AccentLink}"/>
      <Setter Property="Padding" Value="6,2"/><Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="12,4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Subtle}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegOn}"/><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text1}"/><Setter Property="FontWeight" Value="SemiBold"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Text1}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SegBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="2"/>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="bd" Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="16" Padding="12,5">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLink}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Text1}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Tile" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="bd" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,10,0">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLink}"/><Setter TargetName="bd" Property="BorderThickness" Value="2"/><Setter TargetName="bd" Property="Padding" Value="15,11"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CheckStroke}" Background="{DynamicResource ControlFill}" VerticalAlignment="Center">
            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter x:Name="label" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="label" Property="Margin" Value="0"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsChecked" Value="{x:Null}">
            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter TargetName="mark" Property="Visibility" Value="Visible"/><Setter TargetName="mark" Property="Text" Value="&#xE738;"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Text1}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <TextBlock x:Name="state" Text="Off" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Text1}"/>
          <Border x:Name="track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CheckStroke}" Background="{DynamicResource ControlFill}">
            <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource Text2}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
          </Border>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentText}"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
            <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/><Setter TargetName="state" Property="Text" Value="On"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="knob" Property="Width" Value="14"/><Setter TargetName="knob" Property="Height" Value="14"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Text1}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/><Setter Property="CaretBrush" Value="{DynamicResource Text1}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="bd" Background="{DynamicResource InputFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="4" Height="32">
          <Grid>
            <Border x:Name="line" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="Transparent"/>
            <Grid Margin="10,0,8,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource InputFocus}"/><Setter TargetName="line" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- A multi-line field that matches Search: rounded, a hint from Tag, the accent line while typing. -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/><Setter Property="CaretBrush" Value="{DynamicResource Text1}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/><Setter Property="Padding" Value="6,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="bd" Background="{DynamicResource InputFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="4">
          <Grid>
            <Border x:Name="line" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="Transparent"/>
            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Text3}" Margin="8,5" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource InputFocus}"/><Setter TargetName="line" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border x:Name="t" Background="{DynamicResource Thumb}" CornerRadius="3" Width="4" HorizontalAlignment="Center" Margin="0,2"/>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Width" Value="7"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter Property="MinHeight" Value="12"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border Background="{DynamicResource Thumb}" CornerRadius="3" Height="4" VerticalAlignment="Center" Margin="2,0"/>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="{DynamicResource Menu}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1" CornerRadius="6" Padding="9,6" MaxWidth="420">
          <ContentPresenter TextElement.FontSize="12"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{DynamicResource Menu}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220" Margin="10,6,10,14">
          <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black"/></Border.Effect>
          <StackPanel IsItemsHost="True"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="10,7" Margin="0,1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Text2}" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Subtle}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Divider}" Margin="-4,4"/></ControlTemplate></Setter.Value></Setter></Style>

    <Style x:Key="Rows" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text1}"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="4" Margin="0,1" Padding="10,7">
            <Grid>
              <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/>
              <ContentPresenter/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Subtle}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/><Setter TargetName="pill" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,1,8,2"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{DynamicResource OtherSoft}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding AnswerKey}" Value="safe"><Setter Property="Background" Value="{DynamicResource SafeSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="rebuild"><Setter Property="Background" Value="{DynamicResource RebuildSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="review"><Setter Property="Background" Value="{DynamicResource ReviewSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="keep"><Setter Property="Background" Value="{DynamicResource KeepSoft}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AnswerText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Other}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding AnswerKey}" Value="safe"><Setter Property="Foreground" Value="{DynamicResource Safe}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="rebuild"><Setter Property="Foreground" Value="{DynamicResource Rebuild}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="review"><Setter Property="Foreground" Value="{DynamicResource Review}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="keep"><Setter Property="Foreground" Value="{DynamicResource Keep}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AnswerBar" TargetType="Border">
      <Setter Property="Width" Value="3"/><Setter Property="CornerRadius" Value="1.5"/><Setter Property="Background" Value="{DynamicResource Other}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding AnswerKey}" Value="safe"><Setter Property="Background" Value="{DynamicResource Safe}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="rebuild"><Setter Property="Background" Value="{DynamicResource Rebuild}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="review"><Setter Property="Background" Value="{DynamicResource Review}"/></DataTrigger>
        <DataTrigger Binding="{Binding AnswerKey}" Value="keep"><Setter Property="Background" Value="{DynamicResource Keep}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Tag" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="5,0,5,1"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <DataTemplate x:Key="FreeRow">
      <Grid Height="44" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
        <Border Grid.Column="1" Style="{StaticResource AnswerBar}" Height="32" HorizontalAlignment="Left"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
            <TextBlock Text="{Binding Answer}" Style="{StaticResource AnswerText}"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis">
              <Run Text=" · "/><Run Text="{Binding Reason, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SubLine, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,8,0">
          <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding GrowthText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Growing}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FolderRow">
      <Grid Height="40" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{DynamicResource ColReason}"/><ColumnDefinition Width="{DynamicResource ColSize}"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Border x:Name="growTag" Style="{StaticResource Tag}" Background="{DynamicResource ReviewSoft}" Visibility="Collapsed"><TextBlock Text="Growing" FontSize="11" Foreground="{DynamicResource Growing}"/></Border>
            <Border x:Name="watchTag" Style="{StaticResource Tag}" Background="{DynamicResource RebuildSoft}" Visibility="Collapsed"><TextBlock Text="Watched" FontSize="11" Foreground="{DynamicResource Rebuild}"/></Border>
            <Border x:Name="ignoreTag" Style="{StaticResource Tag}" Background="{DynamicResource OtherSoft}" Visibility="Collapsed"><TextBlock Text="Ignored" FontSize="11" Foreground="{DynamicResource Text2}"/></Border>
            </StackPanel>
            <TextBlock Text="{Binding SubLine}" FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding Answer}" Style="{StaticResource AnswerText}"/></Border>
          <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis" Margin="2,1,0,0" ToolTip="{Binding Reason}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
          <TextBlock x:Name="when" Text="{Binding LatestText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Growing}" Value="True">
          <Setter TargetName="growTag" Property="Visibility" Value="Visible"/>
          <Setter TargetName="when" Property="Text" Value="{Binding GrowthShort}"/><Setter TargetName="when" Property="Foreground" Value="{DynamicResource Growing}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Watched}" Value="True"><Setter TargetName="watchTag" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Ignored}" Value="True"><Setter TargetName="ignoreTag" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <!-- Sidebar: Mica shows through where Windows allows it -->
    <DockPanel Margin="8,10,8,12">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6,0,16">
        <Image x:Name="AppIcon" Width="20" Height="20" Margin="0,0,12,0"/>
        <TextBlock x:Name="AppName" Text="Context Cleaner" FontSize="13" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
        <ListBox x:Name="NavFooter" Style="{StaticResource Rows}" Margin="0,0,0,8">
          <ListBoxItem Tag="settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="Settings"/></StackPanel></ListBoxItem>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
          <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,0,10,0"/>
          <TextBlock x:Name="NeverDeletes" Text="Never deletes. You decide." Style="{StaticResource Caption}"/>
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="Nav" Style="{StaticResource Rows}">
        <ListBoxItem Tag="overview" IsSelected="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF0E2;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="Overview"/></StackPanel></ListBoxItem>
        <ListBoxItem Tag="free"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="Free Up Space"/></StackPanel></ListBoxItem>
        <ListBoxItem Tag="folders"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="Folders"/></StackPanel></ListBoxItem>
        <ListBoxItem Tag="watch"><DockPanel><TextBlock x:Name="BadgeWatch" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE890;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="Watchlist"/></StackPanel></DockPanel></ListBoxItem>
        <ListBoxItem Tag="ignored"><DockPanel><TextBlock x:Name="BadgeIgnored" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock Text="&#xED1A;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="Ignored"/></StackPanel></DockPanel></ListBoxItem>
        <ListBoxItem Tag="unread"><DockPanel><TextBlock x:Name="BadgeUnread" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="UnreadGlyph" Text="&#xE7BA;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="Couldn't Scan"/></StackPanel></DockPanel></ListBoxItem>
        <ListBoxItem Tag="history"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" Margin="2,0,14,0"/><TextBlock Text="History"/></StackPanel></ListBoxItem>
      </ListBox>
    </DockPanel>

    <!-- Content layer -->
    <Border Grid.Column="1" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource LayerStroke}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Margin="32,22,24,0" VerticalAlignment="Top">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <StackPanel x:Name="FreeMini" Margin="0,0,18,0" VerticalAlignment="Center" Width="170">
              <TextBlock x:Name="FreeMiniText" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource Text2}"/>
              <Border Height="4" CornerRadius="2" Background="{DynamicResource Divider}" Margin="0,5,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="FreeMiniUsed" Width="0*"/><ColumnDefinition x:Name="FreeMiniFree" Width="1*"/></Grid.ColumnDefinitions>
                  <Border CornerRadius="2" Background="{DynamicResource Accent}"/></Grid>
              </Border>
            </StackPanel>
            <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Tag="Search folders (Ctrl+F)" Width="250" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button x:Name="StopButton" Visibility="Collapsed" Margin="0,0,8,0" ToolTip="Stop the scan (Esc)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Stop"/></StackPanel></Button>
            <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" ToolTip="Scan your drive. Reads sizes and dates only (Ctrl+R)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Scan"/></StackPanel></Button>
            <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="4,0,0,0" ToolTip="More" AutomationProperties.Name="More">
              <Button.ContextMenu><ContextMenu>
                <MenuItem x:Name="MenuExport" Header="Export Cleanup List…" Tag="&#xE9F9;" InputGestureText="Ctrl+E"/>
                <MenuItem x:Name="MenuBin" Header="Open Recycle Bin" Tag="&#xE74D;"/>
                <MenuItem x:Name="MenuStorage" Header="Open Storage Settings" Tag="&#xEDA2;"/>
                <Separator/>
                <MenuItem x:Name="MenuData" Header="Open Context Cleaner's Data Folder" Tag="&#xE838;"/>
              </ContextMenu></Button.ContextMenu>
            </Button>
          </StackPanel>
          <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="-8,4,8,0" VerticalAlignment="Top" Visibility="Collapsed" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back"/>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Style="{StaticResource Title}" Text="Overview" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Secondary}" Margin="32,62,24,12" VerticalAlignment="Top"/>

        <Grid Grid.Row="1">
          <!-- Overview -->
          <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto" Padding="32,4,24,24">
            <StackPanel>
              <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Free space" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock x:Name="OvFree" FontFamily="{StaticResource Display}" FontSize="40" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="OvFreeOf" Style="{StaticResource Secondary}"/>
                    <TextBlock x:Name="OvChange" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OvChangeSub" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    <Border Style="{StaticResource SegBox}" HorizontalAlignment="Left" Margin="0,14,0,0">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Range1" Style="{StaticResource Seg}" Content="24 hours" GroupName="range"/>
                        <RadioButton x:Name="Range7" Style="{StaticResource Seg}" Content="7 days" GroupName="range" IsChecked="True"/>
                        <RadioButton x:Name="Range30" Style="{StaticResource Seg}" Content="30 days" GroupName="range"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Canvas x:Name="OvChart" Grid.Column="1" Height="170" ClipToBounds="True" Margin="16,0,0,0" Background="Transparent"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                <StackPanel>
                  <DockPanel>
                    <TextBlock x:Name="OvMapTotal" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock Text="What fills the drive" Style="{StaticResource Strong}"/>
                  </DockPanel>
                  <Border CornerRadius="4" Height="20" Margin="0,10,0,0" ClipToBounds="True" Background="{DynamicResource Divider}"><Grid x:Name="OvBar"/></Border>
                  <WrapPanel x:Name="OvLegend" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>

              <UniformGrid x:Name="OvTiles" Columns="4" Margin="0,0,-10,12"/>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBox}">
                  <DockPanel>
                    <Button x:Name="OvGoFree" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Open Free Up Space" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <StackPanel>
                      <TextBlock x:Name="OvBack" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/>
                      <TextBlock x:Name="OvBackSub" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBox}">
                  <DockPanel>
                    <Button x:Name="OvOpenBin" DockPanel.Dock="Right" Content="Open Recycle Bin" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <StackPanel>
                      <DockPanel><TextBlock DockPanel.Dock="Left" Text="&#xE74D;" Style="{StaticResource Glyph}" Margin="0,0,8,0" Foreground="{DynamicResource Bin}" VerticalAlignment="Top"/><TextBlock x:Name="OvBin" Style="{StaticResource Strong}" TextWrapping="Wrap"/></DockPanel>
                      <TextBlock x:Name="OvBinSub" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Grid>

              <Border x:Name="OvGrowCard" Style="{StaticResource CardBox}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Growing" Style="{StaticResource Strong}"/>
                  <TextBlock x:Name="OvGrowSub" Style="{StaticResource Caption}" Margin="0,2,0,6"/>
                  <ListBox x:Name="OvGrow" Style="{StaticResource Rows}" ItemTemplate="{StaticResource FolderRow}" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                </StackPanel>
              </Border>

              <Border x:Name="OvDrivesCard" Style="{StaticResource CardBox}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Your drives" Style="{StaticResource Strong}"/>
                  <TextBlock x:Name="OvDrivesSub" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
                  <UniformGrid x:Name="OvDrives" Rows="1"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBox}">
                <StackPanel>
                  <TextBlock Text="Biggest folders" Style="{StaticResource Strong}" Margin="0,0,0,6"/>
                  <ListBox x:Name="OvTop" Style="{StaticResource Rows}" ItemTemplate="{StaticResource FolderRow}" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Free Up Space -->
          <DockPanel x:Name="PageFree" Visibility="Collapsed" Margin="32,4,24,12">
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="FreeHead" Style="{StaticResource Subtitle}"/>
                <TextBlock x:Name="FreeHeadSub" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                <WrapPanel Margin="0,12,0,0">
                  <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" GroupName="chip" Margin="0,0,8,8"/>
                  <RadioButton x:Name="ChipLossless" Style="{StaticResource Chip}" GroupName="chip" Margin="0,0,8,8"/>
                  <RadioButton x:Name="ChipReview" Style="{StaticResource Chip}" GroupName="chip" Margin="0,0,16,8"/>
                  <Border Style="{StaticResource SegBox}" Margin="0,0,16,8">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="OrderBig" Style="{StaticResource Seg}" Content="Biggest first" GroupName="order"/>
                      <RadioButton x:Name="OrderKind" Style="{StaticResource Seg}" Content="By kind" GroupName="order"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Untouched for" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Style="{StaticResource SegBox}">
                      <StackPanel x:Name="FreeAges" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Seg}" Content="Any time" Tag="0" GroupName="age"/>
                        <RadioButton Style="{StaticResource Seg}" Content="1 day" Tag="1" GroupName="age"/>
                        <RadioButton Style="{StaticResource Seg}" Content="3 days" Tag="3" GroupName="age"/>
                        <RadioButton Style="{StaticResource Seg}" Content="1 week" Tag="7" GroupName="age"/>
                        <RadioButton Style="{StaticResource Seg}" Content="30 days" Tag="30" GroupName="age"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Nothing lost: safe to remove, or recreated by the next build or download. Review first: may hold something that's only here, so look inside first. Review first items start unticked."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bin}" Margin="0,0,6,0"/>
                  <TextBlock x:Name="FreeBinNote" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                  <Button x:Name="FreeOpenBin" Style="{StaticResource Link}" Content="Open Recycle Bin" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}" Padding="14,8" Margin="0,0,0,8">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock x:Name="FreeTicked" Style="{StaticResource Strong}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Button x:Name="FreeClear" Content="Clear" Margin="0,0,8,0"/>
                  <Button x:Name="FreeTerminal" Margin="0,0,8,0" ToolTip="Opens your terminal. Paste with Ctrl+V and press Enter."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Open Terminal"/></StackPanel></Button>
                  <Button x:Name="FreeCopy" Style="{StaticResource AccentButton}" ToolTip="Copies one command that moves the ticked items to the Recycle Bin (Ctrl+Shift+C)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Copy Command"/></StackPanel></Button>
                </StackPanel>
                <CheckBox x:Name="FreeAll" VerticalAlignment="Center" Margin="2,0,0,0"><TextBlock x:Name="FreeAllText"/></CheckBox>
              </DockPanel>
            </Border>
            <Grid>
              <ScrollViewer x:Name="FreeScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FreeGroups">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,6">
                        <Grid x:Name="head" Height="40" Margin="10,0,8,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding Ticked, Mode=TwoWay}" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="hint" Text="{Binding Hint}" FontSize="12" Margin="10,1,0,0" Foreground="{DynamicResource Safe}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border x:Name="row" Background="Transparent" CornerRadius="4" Padding="10,0,8,0" Margin="0,1">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FreeRow}"/>
                              </Border>
                              <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource Subtle}"/></Trigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ShowHeader}" Value="False"><Setter TargetName="head" Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding Hint}" Value="review first"><Setter TargetName="hint" Property="Foreground" Value="{DynamicResource Review}"/></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel x:Name="FreeEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource Safe}"/>
                <TextBlock x:Name="FreeEmptyText" Style="{StaticResource Secondary}" Margin="0,10,0,0" TextAlignment="Center" MaxWidth="460"/>
              </StackPanel>
            </Grid>
          </DockPanel>

          <!-- Folders, Watchlist, Ignored and Couldn't Scan share one list and one inspector -->
          <Grid x:Name="PageFolders" Visibility="Collapsed" Margin="32,4,24,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="InspectorColumn" Width="360"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <UniformGrid x:Name="FolderTiles" Grid.ColumnSpan="3" Columns="5" Margin="0,0,-10,12">
                <RadioButton x:Name="TileAll" Style="{StaticResource Tile}" GroupName="tile" IsChecked="True"/>
                <RadioButton x:Name="TileSafe" Style="{StaticResource Tile}" GroupName="tile"/>
                <RadioButton x:Name="TileRebuild" Style="{StaticResource Tile}" GroupName="tile"/>
                <RadioButton x:Name="TileReview" Style="{StaticResource Tile}" GroupName="tile"/>
                <RadioButton x:Name="TileKeep" Style="{StaticResource Tile}" GroupName="tile"/>
              </UniformGrid>
            <DockPanel Grid.Row="1">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}">
                  <StackPanel x:Name="FolderSorts" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Seg}" Content="Biggest" Tag="size" GroupName="sort" IsChecked="True"/>
                    <RadioButton Style="{StaticResource Seg}" Content="Growing" Tag="growth" GroupName="sort"/>
                    <RadioButton Style="{StaticResource Seg}" Content="Longest unused" Tag="idle" GroupName="sort"/>
                    <RadioButton Style="{StaticResource Seg}" Content="Name" Tag="name" GroupName="sort"/>
                  </StackPanel>
                </Border>
                <Button x:Name="RescanAll" DockPanel.Dock="Right" Content="Scan These Again" Margin="0,0,10,0" Visibility="Collapsed" ToolTip="Measure these folders again"/>
                <TextBlock x:Name="FolderCount" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
              </DockPanel>
              <Grid DockPanel.Dock="Top" Margin="10,0,22,4">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{DynamicResource ColReason}"/><ColumnDefinition Width="{DynamicResource ColSize}"/></Grid.ColumnDefinitions>
                <TextBlock Text="Folder" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="1" Text="Can I remove it?" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="SizeHeader" Grid.Column="2" Text="Size · last changed" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,10,0" TextWrapping="NoWrap"/>
              </Grid>
              <Border Style="{StaticResource CardBox}" Padding="4">
                <Grid>
                  <ListBox x:Name="FolderList" Style="{StaticResource Rows}" ItemTemplate="{StaticResource FolderRow}" SelectionMode="Extended" AutomationProperties.Name="Folders"/>
                  <TextBlock x:Name="FolderEmpty" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420" Visibility="Collapsed"/>
                </Grid>
              </Border>
            </DockPanel>

            <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource CardBox}" Padding="0">
              <ScrollViewer x:Name="InScroll" VerticalScrollBarVisibility="Auto" Padding="20,18">
                <StackPanel x:Name="Inspector">
                  <TextBlock x:Name="InName" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="InSub" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                  <TextBox x:Name="InPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text2}" FontSize="12" TextWrapping="Wrap" Margin="-2,6,0,0" FontFamily="Cascadia Mono, Consolas"/>
                  <DockPanel Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock x:Name="InSize" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="SemiBold"/>
                      <TextBlock x:Name="InGrowth" FontSize="12" Foreground="{DynamicResource Growing}"/>
                    </StackPanel>
                  </DockPanel>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="InCopy" Style="{StaticResource AccentButton}" Margin="0,0,6,6" Visibility="Collapsed" ToolTip="Copies one command that moves these to the Recycle Bin"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="InCopyText" Text="Copy Command"/></StackPanel></Button>
                    <Button x:Name="InWatch" Margin="0,0,6,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE890;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="InWatchText" Text="Watch"/></StackPanel></Button>
                    <Button x:Name="InIgnore" Margin="0,0,6,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xED1A;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="InIgnoreText" Text="Ignore"/></StackPanel></Button>
                    <Button x:Name="InMore" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="0,0,6,6" ToolTip="More actions" AutomationProperties.Name="More actions for this folder"/>
                    <Button x:Name="InReveal" Margin="0,0,6,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Show in Explorer"/></StackPanel></Button>
                    <Button x:Name="InLook" Margin="0,0,6,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Look Inside"/></StackPanel></Button>
                    <Button x:Name="InAction" Margin="0,0,6,6"/>
                    <Button x:Name="InTrack" Margin="0,0,6,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="InTrackText" Text="Track This Folder"/></StackPanel></Button>
                  </WrapPanel>
                  <TextBox x:Name="InInside" Visibility="Collapsed" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxHeight="260" Margin="0,4,0,8"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}" Background="{DynamicResource ControlFill}" Foreground="{DynamicResource Text1}" Padding="8"/>
                  <Border x:Name="InAnswerBox" CornerRadius="8" Padding="14,12" Margin="0,8,0,0" BorderThickness="3,0,0,0" Background="{DynamicResource ControlFill}">
                    <StackPanel>
                      <TextBlock x:Name="InAnswer" FontWeight="SemiBold"/>
                      <TextBlock x:Name="InReason" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
                      <TextBlock x:Name="InWhat" TextWrapping="Wrap"/>
                      <TextBlock Text="If you remove it" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                      <TextBlock x:Name="InCost" TextWrapping="Wrap"/>
                      <StackPanel x:Name="InHowBox">
                        <TextBlock Text="How to get space back yourself" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBox x:Name="InHow" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" Padding="0" Margin="-2,0,0,0"/>
                      </StackPanel>
                      <TextBlock x:Name="InEvidence" Style="{StaticResource Caption}" Margin="0,10,0,0"/>

                    </StackPanel>
                  </Border>
                  <StackPanel x:Name="InNoteBox" Margin="0,14,0,0">
                    <TextBlock Text="Your note" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="InNote" Style="{StaticResource Field}" Tag="Why you keep it, or what to check first" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="34" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Your note on this folder" ToolTip="Saved as you type. Search finds folders by their notes."/>
                  </StackPanel>
                  <DockPanel x:Name="InChartHead" Margin="0,18,0,0">
                    <TextBlock x:Name="InChartChange" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource AccentLink}"/>
                    <TextBlock Text="Size over time" Style="{StaticResource Strong}"/>
                  </DockPanel>
                  <Canvas x:Name="InChart" Height="120" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent"/>
                  <TextBlock x:Name="InChartSub" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- History -->
          <DockPanel x:Name="PageHistory" Visibility="Collapsed" Margin="32,4,24,12">
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Moved to the Recycle Bin, last 7 days" Style="{StaticResource Caption}"/>
                  <TextBlock x:Name="HiWeek" Style="{StaticResource Subtitle}"/>
                  <TextBlock x:Name="HiWeekSub" Style="{StaticResource Caption}"/>
                  <TextBlock Text="All time" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                  <TextBlock x:Name="HiAll" Style="{StaticResource Subtitle}"/>
                  <TextBlock x:Name="HiAllSub" Style="{StaticResource Caption}"/>
                  <TextBlock Text="Space comes back when you empty the Recycle Bin." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                  <Button x:Name="HiOpenBin" Style="{StaticResource Link}" Content="Open Recycle Bin" FontSize="12" HorizontalAlignment="Left" Margin="-6,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                  <TextBlock x:Name="HiChartTitle" Style="{StaticResource Caption}"/>
                  <Canvas x:Name="HiChart" Height="130" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border DockPanel.Dock="Top" Style="{StaticResource SegBox}" HorizontalAlignment="Center" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="HiTabCleanups" Style="{StaticResource Seg}" Content="Cleanups" GroupName="hist" IsChecked="True"/>
                <RadioButton x:Name="HiTabScans" Style="{StaticResource Seg}" Content="Scans" GroupName="hist"/>
              </StackPanel>
            </Border>
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HiList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Day}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="4,4,0,6"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource CardBox}" Padding="0" Margin="0,0,0,4">
                                <Expander>
                                  <Expander.Template>
                                    <ControlTemplate TargetType="Expander">
                                      <StackPanel>
                                        <ToggleButton x:Name="tg" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" FocusVisualStyle="{StaticResource FocusRing}">
                                          <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                              <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,10">
                                                <Grid>
                                                  <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                                  <TextBlock x:Name="chev" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Text2}"/>
                                                  <TextBlock Grid.Column="1" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Foreground="{Binding IconBrush}"/>
                                                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Text1}"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                                                  </StackPanel>
                                                  <TextBlock Grid.Column="3" Text="{Binding Size}" FontWeight="SemiBold" Foreground="{DynamicResource Safe}" VerticalAlignment="Center" Margin="12,0"/>
                                                  <TextBlock Grid.Column="4" Text="{Binding Time}" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                              </Border>
                                              <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Subtle}"/></Trigger>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="Text" Value="&#xE70D;"/></Trigger>
                                              </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                          </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="body" Visibility="Collapsed"/>
                                      </StackPanel>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="body" Property="Visibility" Value="Visible"/></Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Expander.Template>
                                  <TextBox Text="{Binding Lines, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text2}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="64,0,14,12"/>
                                </Expander>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock x:Name="HiEmpty" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="440" Visibility="Collapsed"/>
            </Grid>
          </DockPanel>

          <!-- Settings -->
          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,4,24,24">
            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
              <TextBlock Text="Appearance and behavior" Style="{StaticResource Strong}" Margin="2,0,0,8"/>
              <Border Style="{StaticResource CardBox}" Margin="0,0,0,4">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
                    <StackPanel x:Name="SetTheme" Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Seg}" Content="Use Windows setting" Tag="System" GroupName="theme"/>
                      <RadioButton Style="{StaticResource Seg}" Content="Light" Tag="Light" GroupName="theme"/>
                      <RadioButton Style="{StaticResource Seg}" Content="Dark" Tag="Dark" GroupName="theme"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0"/>
                  <StackPanel><TextBlock Text="App theme"/><TextBlock Text="Follows Windows' light or dark mode and accent color unless you choose." Style="{StaticResource Caption}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardBox}" Margin="0,0,0,4">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
                    <StackPanel x:Name="SetTerminal" Orientation="Horizontal"/>
                  </Border>
                  <TextBlock Text="&#xE756;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0"/>
                  <StackPanel><TextBlock Text="Open commands in"/><TextBlock Text="Open Terminal opens this. You paste the copied command with Ctrl+V and press Enter; Context Cleaner never runs it." Style="{StaticResource Caption}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardBox}" Margin="0,0,0,4">
                <DockPanel>
                  <CheckBox x:Name="SetDaily" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0"/>
                  <StackPanel><TextBlock Text="Scan once a day"/><TextBlock x:Name="SetDailySub" Style="{StaticResource Caption}"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardBox}" Margin="0,0,0,18">
                <DockPanel>
                  <CheckBox x:Name="SetShortcut" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE8FC;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0"/>
                  <StackPanel><TextBlock Text="Start menu shortcut"/><TextBlock Text="Open Context Cleaner from Start, with its icon and no console window. Pin it to Start or the taskbar from there." Style="{StaticResource Caption}"/></StackPanel>
                </DockPanel>
              </Border>

              <TextBlock Text="Where Context Cleaner looks" Style="{StaticResource Strong}" Margin="2,0,0,2"/>
              <TextBlock Text="Turn off a place to stop reading it. What it holds then counts under Everything else." Style="{StaticResource Caption}" Margin="2,0,0,8"/>
              <Border Style="{StaticResource CardBox}" Padding="0" Margin="0,0,0,18">
                <ItemsControl x:Name="SetCoverage">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="20,10">
                        <DockPanel>
                          <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding On, Mode=OneWay}" Tag="{Binding Key}" VerticalAlignment="Center"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                          <StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"/></StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <DockPanel Margin="2,0,0,2">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="SetRootsAuto" Style="{StaticResource Link}" Content="Find Automatically" Margin="0,0,6,0"/>
                  <Button x:Name="SetRootsAdd" Content="Add Folder…"/>
                </StackPanel>
                <StackPanel><TextBlock Text="Project folders" Style="{StaticResource Strong}"/>
                  <TextBlock x:Name="SetRootsSub" Style="{StaticResource Caption}"/></StackPanel>
              </DockPanel>
              <Border Style="{StaticResource CardBox}" Padding="0" Margin="0,8,0,18"><ItemsControl x:Name="SetRoots"/></Border>

              <DockPanel Margin="2,0,0,2">
                <Button x:Name="SetTrackAdd" DockPanel.Dock="Right" Content="Add Folder…"/>
                <StackPanel><TextBlock Text="Your folders" Style="{StaticResource Strong}"/>
                  <TextBlock Text="Folders in your home folder scanned item by item. What sits untouched inside shows in Free Up Space as Review first." Style="{StaticResource Caption}"/></StackPanel>
              </DockPanel>
              <Border Style="{StaticResource CardBox}" Padding="0" Margin="0,8,0,18"><ItemsControl x:Name="SetTracked"/></Border>

              <TextBlock Text="Not scanned" Style="{StaticResource Strong}" Margin="2,0,0,2"/>
              <TextBlock Text="Folders you stopped scanning. Their size is the last one seen." Style="{StaticResource Caption}" Margin="2,0,0,8"/>
              <Border Style="{StaticResource CardBox}" Padding="0" Margin="0,0,0,18"><ItemsControl x:Name="SetOff"/></Border>

              <TextBlock Text="About" Style="{StaticResource Strong}" Margin="2,0,0,8"/>
              <Border Style="{StaticResource CardBox}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SetOpenData" Content="Open Data Folder" Margin="0,0,8,0"/>
                    <Button x:Name="SetGitHub" Content="GitHub"/>
                  </StackPanel>
                  <Image x:Name="AboutIcon" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top"/>
                  <StackPanel>
                    <TextBlock x:Name="SetVersion" FontWeight="SemiBold"/>
                    <TextBlock Text="Context Cleaner never deletes files. It reads sizes and dates, and copies a command that moves what you tick to the Recycle Bin. No network access." Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SetDataText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="32,8,24,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="440"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <ProgressBar x:Name="ScanProgress" Width="90" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}" BorderThickness="0"/>
              <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="Message" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="24,0,0,0"/>
            <Button x:Name="MessageTerminal" Grid.Column="2" Style="{StaticResource Link}" Content="Open Terminal" FontSize="12" Visibility="Collapsed" Margin="6,0,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

